# Django
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=lunch_voting
POSTGRES_USER=lunch_voting
POSTGRES_PASSWORD=lunch_voting
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Time zone (default: UTC)
TIME_ZONE=UTC

# Business rule: employees can change their vote until this hour (24h, server local time)
VOTE_DEADLINE_HOUR=11

# Mobile app version breakpoint for backward compatibility
# Clients with version < APP_VERSION_BREAKPOINT receive legacy response format
APP_VERSION_BREAKPOINT=2.0.0

# CORS settings for mobile app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=True

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
DB_LOG_LEVEL=WARNING

# Security (set to True in production with HTTPS)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
